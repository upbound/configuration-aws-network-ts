#!/bin/sh
# Refuses to commit AWS credentials.
#
# Enable with:
#
#   git config core.hooksPath .githooks
#
# The check itself lives in hack/check-credentials.sh, which CI runs over the
# whole tree, so the hook and CI cannot drift apart. `git commit --no-verify`
# bypasses this.
exec "$(git rev-parse --show-toplevel)/hack/check-credentials.sh" --staged
